<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/utsavas_surface"
    android:orientation="vertical">

    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/utsavas_accent"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbarStyle="outsideOverlay" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/offlineContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/utsavas_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/offlineLogo"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/utsavas_app_icon" />

            <TextView
                android:id="@+id/offlineTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/offline_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/utsavas_text" />

            <TextView
                android:id="@+id/offlineMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/offline_message"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/utsavas_text"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/retry"
                android:textColor="@color/utsavas_on_accent"
                app:backgroundTint="@color/utsavas_accent"
                app:cornerRadius="16dp"
                app:iconTint="@color/utsavas_on_accent" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/utsavas_surface_dark"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="@string/nav_back"
            android:textAllCaps="false"
            android:textColor="@color/utsavas_primary"
            app:icon="@android:drawable/ic_media_previous"
            app:iconGravity="textTop"
            app:iconPadding="6dp"
            app:iconTint="@color/utsavas_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionForward"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="@string/nav_forward"
            android:textAllCaps="false"
            android:textColor="@color/utsavas_primary"
            app:icon="@android:drawable/ic_media_next"
            app:iconGravity="textTop"
            app:iconPadding="6dp"
            app:iconTint="@color/utsavas_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionHome"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="@string/nav_home"
            android:textAllCaps="false"
            android:textColor="@color/utsavas_primary"
            app:icon="@android:drawable/ic_menu_view"
            app:iconGravity="textTop"
            app:iconPadding="6dp"
            app:iconTint="@color/utsavas_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionRefresh"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="@string/nav_refresh"
            android:textAllCaps="false"
            android:textColor="@color/utsavas_primary"
            app:icon="@android:drawable/ic_popup_sync"
            app:iconGravity="textTop"
            app:iconPadding="6dp"
            app:iconTint="@color/utsavas_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionShare"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="@string/nav_share"
            android:textAllCaps="false"
            android:textColor="@color/utsavas_primary"
            app:icon="@android:drawable/ic_menu_share"
            app:iconGravity="textTop"
            app:iconPadding="6dp"
            app:iconTint="@color/utsavas_primary" />
    </LinearLayout>
</LinearLayout>
